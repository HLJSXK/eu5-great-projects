# Scheme A: grouped list + detail.
# Replaces the proposal card, slot buttons and action row inside the overview
# "common_bottom_content" vbox. The existing proposal preview widget stays below
# and shows the selected candidate (tv_wonder_proposal / tv_wonder_proposal_site).
#
# Data: two country variable lists of candidate site locations.
#   tv_wonder_priority_unfinished_list, tv_wonder_priority_expansion_list
# Per-location display variables, refreshed when the priority deck is rebuilt:
#   tv_wonder_priority_display_id, tv_wonder_priority_display_mode (1/2),
#   tv_wonder_priority_display_module_1..4 (set = module built),
#   tv_wonder_priority_display_level, tv_wonder_priority_display_cap

hbox = {
	layoutpolicy_horizontal = expanding
	layoutpolicy_vertical = fixed
	size = { 470 96 }
	spacing = 10
	margin = { 8 8 }
	using = bg_paper_card_situations

	widget = {
		size = { 64 78 }
		portrait_standard_head_button = {
			using = character_portrait_bg
			parentanchor = center
			widgetanchor = center
			size = { 52 64 }
			datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').GetCharacter]"
			icon = {
				texture = "gfx/interface/component_decoration/character_frames/character_frame_1.dds"
				texture_density = 2
				size = { 100% 100% }
			}
		}
	}
	widget = {
		size = { 380 78 }
		using = bg_text_mask_container_dark_blue
		text_multi = {
			position = { 8 8 }
			max_width = 364
			autoresize = yes
			text = "TV_ENGINEERING_PRIORITY_LIST_TEXT"
			align = nobaseline|left
		}
	}
}

# ---- unfinished section header
widget = {
	layoutpolicy_horizontal = fixed
	size = { 470 28 }
	using = bg_text_mask_container_dark_blue
	widget = {
		size = { 4 20 }
		position = { 6 4 }
		background = { using = color_yellow_texture alpha = 1.0 }
	}
	text_single = {
		position = { 18 0 }
		size = { 300 28 }
		text = "TV_ENGINEERING_PRIORITY_UNFINISHED_HEADER"
		fontsize = 15
		align = nobaseline|left
	}
	text_single = {
		parentanchor = right
		position = { -10 0 }
		size = { 60 28 }
		raw_text = "[GetDataModelSize(InternationalOrganizationsView.GetPlayer.MakeScope.GetList('tv_wonder_priority_unfinished_list'))|0]"
		fontsize = 15
		align = nobaseline|right
	}
}

vbox = {
	layoutpolicy_horizontal = expanding
	spacing = 3
	datamodel = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetList('tv_wonder_priority_unfinished_list')]"
	item = {
		widget = {
			size = { 470 52 }
			using = bg_text_mask_container_dark_blue
			widget = {
				visible = "[ObjectsEqual(Scope.GetLocation.Self, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_site').GetLocation.Self)]"
				size = { 100% 100% }
				background = { using = color_market_green_texture alpha = 0.35 }
			}
			widget = {
				visible = "[ObjectsEqual(Scope.GetLocation.Self, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_site').GetLocation.Self)]"
				size = { 4 100% }
				background = { using = color_market_green_texture alpha = 1.0 }
			}
			widget = {
				position = { 10 6 }
				size = { 64 40 }
				background = {
					texture = "[GetConceptTexture(Concatenate('tv_wonder_display_full_image_', ToString_int32(FixedPointToInt(Scope.GetLocation.MakeScope.GetVariable('tv_wonder_priority_display_id').GetValue))))]"
					fittype = centercrop
				}
			}
			text_single = {
				position = { 84 6 }
				size = { 180 22 }
				text = "[SelectGameConcept(Scope.GetLocation.MakeScope.GetVariable('tv_wonder_priority_display_id').IsSet, Concatenate('tv_wonder_display_', ToString_int32(FixedPointToInt(Scope.GetLocation.MakeScope.GetVariable('tv_wonder_priority_display_id').GetValue))), 'tv_wonder_construction')]"
				fontsize = 15
				align = nobaseline|left
			}
			text_single = {
				position = { 84 28 }
				size = { 180 18 }
				raw_text = "#weak [Scope.GetLocation.GetName]#!"
				fontsize = 12
				align = nobaseline|left
			}
			widget = {
				parentanchor = right|vcenter
				position = { -10 0 }
				size = { 172 20 }
				widget = {
					position = { 0 0 }
					size = { 40 20 }
					background = { using = color_black_texture alpha = 0.5 }
					widget = { visible = "[Scope.GetLocation.MakeScope.GetVariable('tv_wonder_priority_display_module_1').IsSet]" size = { 100% 100% } background = { using = color_yellow_texture alpha = 0.85 } }
					text_single = { size = { 100% 100% } text = "TV_ENGINEERING_PRIORITY_MODULE_1" fontsize = 12 align = center|nobaseline }
				}
				widget = {
					position = { 44 0 }
					size = { 40 20 }
					background = { using = color_black_texture alpha = 0.5 }
					widget = { visible = "[Scope.GetLocation.MakeScope.GetVariable('tv_wonder_priority_display_module_2').IsSet]" size = { 100% 100% } background = { using = color_yellow_texture alpha = 0.85 } }
					text_single = { size = { 100% 100% } text = "TV_ENGINEERING_PRIORITY_MODULE_2" fontsize = 12 align = center|nobaseline }
				}
				widget = {
					position = { 88 0 }
					size = { 40 20 }
					background = { using = color_black_texture alpha = 0.5 }
					widget = { visible = "[Scope.GetLocation.MakeScope.GetVariable('tv_wonder_priority_display_module_3').IsSet]" size = { 100% 100% } background = { using = color_yellow_texture alpha = 0.85 } }
					text_single = { size = { 100% 100% } text = "TV_ENGINEERING_PRIORITY_MODULE_3" fontsize = 12 align = center|nobaseline }
				}
				widget = {
					position = { 132 0 }
					size = { 40 20 }
					background = { using = color_black_texture alpha = 0.5 }
					widget = { visible = "[Scope.GetLocation.MakeScope.GetVariable('tv_wonder_priority_display_module_4').IsSet]" size = { 100% 100% } background = { using = color_yellow_texture alpha = 0.85 } }
					text_single = { size = { 100% 100% } text = "TV_ENGINEERING_PRIORITY_MODULE_4" fontsize = 12 align = center|nobaseline }
				}
			}
			button = {
				size = { 100% 100% }
				scripted_action_tooltip = {
					click_type = left
					click_mode = single
					action_name = "tv_wonder_select_priority_candidate"
					actor = "[InternationalOrganizationsView.GetPlayer]"
					parameter = { parameter_name = "target_1" parameter_value = "[Scope.GetLocation]" }
				}
			}
		}
	}
}

# ---- expansion section header
widget = {
	layoutpolicy_horizontal = fixed
	size = { 470 28 }
	using = bg_text_mask_container_dark_blue
	widget = {
		size = { 4 20 }
		position = { 6 4 }
		background = { using = color_market_green_texture alpha = 1.0 }
	}
	text_single = {
		position = { 18 0 }
		size = { 300 28 }
		text = "TV_ENGINEERING_PRIORITY_EXPANSION_HEADER"
		fontsize = 15
		align = nobaseline|left
	}
	text_single = {
		parentanchor = right
		position = { -10 0 }
		size = { 60 28 }
		raw_text = "[GetDataModelSize(InternationalOrganizationsView.GetPlayer.MakeScope.GetList('tv_wonder_priority_expansion_list'))|0]"
		fontsize = 15
		align = nobaseline|right
	}
}

vbox = {
	layoutpolicy_horizontal = expanding
	spacing = 3
	datamodel = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetList('tv_wonder_priority_expansion_list')]"
	item = {
		widget = {
			size = { 470 52 }
			using = bg_text_mask_container_dark_blue
			widget = {
				visible = "[ObjectsEqual(Scope.GetLocation.Self, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_site').GetLocation.Self)]"
				size = { 100% 100% }
				background = { using = color_market_green_texture alpha = 0.35 }
			}
			widget = {
				visible = "[ObjectsEqual(Scope.GetLocation.Self, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_site').GetLocation.Self)]"
				size = { 4 100% }
				background = { using = color_market_green_texture alpha = 1.0 }
			}
			widget = {
				position = { 10 6 }
				size = { 64 40 }
				background = {
					texture = "[GetConceptTexture(Concatenate('tv_wonder_display_full_image_', ToString_int32(FixedPointToInt(Scope.GetLocation.MakeScope.GetVariable('tv_wonder_priority_display_id').GetValue))))]"
					fittype = centercrop
				}
			}
			text_single = {
				position = { 84 6 }
				size = { 180 22 }
				text = "[SelectGameConcept(Scope.GetLocation.MakeScope.GetVariable('tv_wonder_priority_display_id').IsSet, Concatenate('tv_wonder_display_', ToString_int32(FixedPointToInt(Scope.GetLocation.MakeScope.GetVariable('tv_wonder_priority_display_id').GetValue))), 'tv_wonder_construction')]"
				fontsize = 15
				align = nobaseline|left
			}
			text_single = {
				position = { 84 28 }
				size = { 180 18 }
				raw_text = "#weak [Scope.GetLocation.GetName]#!"
				fontsize = 12
				align = nobaseline|left
			}
			text_single = {
				parentanchor = right
				position = { -10 6 }
				size = { 160 22 }
				raw_text = "[Scope.GetLocation.MakeScope.GetVariable('tv_wonder_priority_display_level').GetValue|0] 级  #weak / 上限 [Scope.GetLocation.MakeScope.GetVariable('tv_wonder_priority_display_cap').GetValue|0] 级#!"
				fontsize = 14
				align = nobaseline|right
			}
			progressbar = {
				parentanchor = right
				position = { -10 32 }
				size = { 172 10 }
				using = progress_bar_green_alt
				max = "[Scope.GetLocation.MakeScope.GetVariable('tv_wonder_priority_display_cap').GetValue]"
				value = "[Scope.GetLocation.MakeScope.GetVariable('tv_wonder_priority_display_level').GetValue]"
			}
			button = {
				size = { 100% 100% }
				scripted_action_tooltip = {
					click_type = left
					click_mode = single
					action_name = "tv_wonder_select_priority_candidate"
					actor = "[InternationalOrganizationsView.GetPlayer]"
					parameter = { parameter_name = "target_1" parameter_value = "[Scope.GetLocation]" }
				}
			}
		}
	}
}

hbox = {
	layoutpolicy_horizontal = expanding
	spacing = 4
	expand = {}
	button_regular = {
		enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
		size = { 92 28 }
		text = "TV_ENGINEERING_ACCEPT_BUTTON"
		scripted_action_tooltip = { click_type = left click_mode = single action_name = "tv_wonder_accept_proposal" actor = "[InternationalOrganizationsView.GetPlayer]" }
	}
	button_regular = {
		enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
		size = { 92 28 }
		text = "TV_ENGINEERING_REFUTE_BUTTON"
		scripted_action_tooltip = { click_type = left click_mode = single action_name = "tv_wonder_refute_proposal" actor = "[InternationalOrganizationsView.GetPlayer]" }
	}
	button_regular = {
		enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
		size = { 92 28 }
		text = "TV_ENGINEERING_BRIBE_BUTTON"
		scripted_action_tooltip = { click_type = left click_mode = single action_name = "tv_wonder_bribe_proposal" actor = "[InternationalOrganizationsView.GetPlayer]" }
	}
}
