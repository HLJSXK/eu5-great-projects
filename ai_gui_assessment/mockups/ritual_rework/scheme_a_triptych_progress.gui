# ---------- effects of the selected style: engine-generated description of the real
# completion effect (dispatches on tv_wonder_locked + tv_wonder_ritual_choice).
widget = {
	size = { 462 170 }
	using = bg_paper_card_situations
	vbox = {
		position = { 0 0 }
		size = { 462 170 }
		margin = { 12 8 }
		spacing = 4
		text_single = { layoutpolicy_horizontal = expanding size = { 438 22 } text = "RR_A_EFFECTS_TITLE" fontsize = 15 align = nobaseline|left }
		text_multi = {
			layoutpolicy_horizontal = expanding
			minimumsize = { 430 -1 }
			max_width = 430
			autoresize = yes
			raw_text = "[ShowScriptedEffectForScope('tv_wonder_ritual_apply_choice_effect',InternationalOrganizationsView.GetPlayer.MakeScope.Self)]"
			fontsize = 13
			align = nobaseline|left
		}
		expand = {}
	}
}

# ---------- progress
widget = {
	size = { 462 92 }
	using = bg_paper_card_situations
	text_single = { position = { 12 8 } size = { 300 22 } text = "RR_PROGRESS_TITLE" fontsize = 16 align = nobaseline|left }
	text_single = { parentanchor = right position = { -12 8 } size = { 140 22 } text = "RR_PROGRESS_TEXT" align = nobaseline|right }
	progressbar = { position = { 12 36 } size = { 438 16 } progresstexture = "gfx/interface/progressbars/progress_bar_goldish.dds" noprogresstexture = "gfx/interface/progressbars/progress_bar_blue_alt.dds" texture_density = 2 spriteType = Corneredstretched spriteborder = { 12 0 } min = 0 max = 100 value = 42 }
	text_multi = { position = { 12 58 } max_width = 438 autoresize = yes text = "RR_PROGRESS_HINT" fontsize = 12 align = nobaseline|left }
}
