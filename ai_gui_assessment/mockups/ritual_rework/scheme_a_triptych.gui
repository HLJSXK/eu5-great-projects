# ---------- effects of the selected style: engine-generated description of the real
# completion effect (dispatches on tv_wonder_locked + tv_wonder_ritual_choice).
# Each card's button tooltip shows the same description for that card's style.
widget = {
	size = { 462 170 }
	using = bg_paper_card_situations
	vbox = {
		position = { 0 0 }
		size = { 462 170 }
		margin = { 12 8 }
		spacing = 4
		text_single = { layoutpolicy_horizontal = expanding size = { 438 22 } text = "RR_A_EFFECTS_TITLE" fontsize = 15 align = nobaseline|left }
		text_multi = {
			layoutpolicy_horizontal = expanding
			minimumsize = { 430 -1 }
			max_width = 430
			autoresize = yes
			raw_text = "[ShowScriptedEffectForScope('tv_wonder_ritual_apply_choice_effect',InternationalOrganizationsView.GetPlayer.MakeScope.Self)]"
			fontsize = 13
			align = nobaseline|left
		}
		expand = {}
	}
}

# ---------- plain strip
widget = {
	size = { 462 62 }
	using = bg_text_mask_container_dark_blue
	text_single = { position = { 10 6 } size = { 300 22 } text = "RR_PLAIN_TITLE" fontsize = 16 align = nobaseline|left }
	text_multi = { position = { 10 28 } max_width = 300 autoresize = yes text = "RR_PLAIN_DESC" fontsize = 12 align = nobaseline|left }
	button_regular = { parentanchor = right|vcenter position = { -10 0 } size = { 130 30 } text = "RR_PLAIN_BUTTON" }
}

# ---------- confirm row
