# Scheme A: triptych. Three equal ritual cards side by side, plain inauguration as a
# full-width strip underneath, and the confirm row at the bottom.
# Sample state: style 1 selected. Draft data only.

widget = {
	size = { 462 52 }
	using = bg_text_mask_container_dark_blue
	text_multi = {
		position = { 10 6 }
		max_width = 442
		autoresize = yes
		text = "RR_HEADER_TEXT"
		align = nobaseline|left
	}
}

hbox = {
	layoutpolicy_horizontal = fixed
	size = { 462 26 }
	text_single = {
		size = { 462 26 }
		text = "RR_SITE_LINE"
		align = nobaseline|left
	}
}

