# ---------- detail sheet
widget = {
	size = { 462 450 }
	using = bg_paper_card_situations

	vbox = {
		position = { 0 0 }
		size = { 462 450 }
		margin = { 12 10 }
		spacing = 6

		hbox = {
			layoutpolicy_horizontal = expanding
			size = { 438 26 }
			text_single = { size = { 200 26 } text = "RR_S1_NAME" fontsize = 19 align = nobaseline|left }
			expand = {}
			text_single = { size = { 120 26 } text = "RR_S1_KIND" fontsize = 13 align = nobaseline|right }
		}
		text_multi = { layoutpolicy_horizontal = expanding max_width = 438 autoresize = yes text = "RR_C_DESC" fontsize = 13 align = nobaseline|left }

		# effects: engine-generated description of the real completion effect that the
		# ritual executes (country scope, dispatches on tv_wonder_locked + tv_wonder_ritual_choice).
		# No hand-written effect text and no tooltip-only wrapper.
		widget = { size = { 438 22 } background = { using = color_black_texture alpha = 0.35 } text_single = { position = { 8 0 } size = { 300 22 } text = "RR_DETAIL_EFFECTS" fontsize = 14 align = nobaseline|left } }
		text_multi = {
			layoutpolicy_horizontal = expanding
			minimumsize = { 430 -1 }
			max_width = 430
			autoresize = yes
			raw_text = "[ShowScriptedEffectForScope('tv_wonder_ritual_apply_choice_effect',InternationalOrganizationsView.GetPlayer.MakeScope.Self)]"
			fontsize = 13
			align = nobaseline|left
		}

		# value axis
		widget = { size = { 438 22 } background = { using = color_black_texture alpha = 0.35 } text_single = { position = { 8 0 } size = { 300 22 } text = "RR_VALUE_LABEL" fontsize = 14 align = nobaseline|left } }
		widget = {
			size = { 438 54 }
			icon = { position = { 0 4 } size = { 36 36 } texture = "gfx/interface/icons/societal_values/aristocracy_vs_plutocracy_left.dds" alpha = 0.6 }
			icon = { position = { 402 4 } size = { 36 36 } texture = "gfx/interface/icons/societal_values/aristocracy_vs_plutocracy_right.dds" }
			widget = { position = { 46 18 } size = { 346 8 } background = { using = color_black_texture alpha = 0.6 } }
			widget = { position = { 219 14 } size = { 2 16 } background = { using = color_white_texture alpha = 0.5 } }
			widget = { position = { 198 12 } size = { 4 20 } background = { using = color_white_texture alpha = 1 } }
			widget = { position = { 202 19 } size = { 34 6 } background = { using = color_yellow_texture alpha = 1 } }
			text_single = { position = { 46 30 } size = { 120 20 } text = "RR_AXIS_LEFT" fontsize = 12 align = nobaseline|left }
			text_single = { position = { 160 30 } size = { 120 20 } text = "RR_AXIS_NOW" fontsize = 12 align = center|nobaseline }
			text_single = { position = { 332 30 } size = { 60 20 } text = "RR_AXIS_RIGHT" fontsize = 12 align = nobaseline|right }
		}

		# estates
		widget = { size = { 438 22 } background = { using = color_black_texture alpha = 0.35 } text_single = { position = { 8 0 } size = { 300 22 } text = "RR_ESTATES_LABEL" fontsize = 14 align = nobaseline|left } }
		hbox = {
			size = { 438 72 }
			spacing = 6
			widget = {
				size = { 105 72 }
				background = { using = color_market_green_texture alpha = 0.25 }
				icon = { position = { 4 6 } size = { 36 36 } texture = "gfx/interface/icons/estates/clergy_estate.dds" }
				text_single = { position = { 44 4 } size = { 60 20 } text = "RR_EST_CLERGY" align = nobaseline|left }
				text_single = { position = { 44 24 } size = { 60 20 } text = "RR_SUPPORT" align = nobaseline|left }
				text_single = { position = { 4 48 } size = { 98 20 } text = "RR_EST_RANDOM_TAG" fontsize = 12 align = nobaseline|left }
			}
			widget = {
				size = { 105 72 }
				background = { using = color_mid_red_texture alpha = 0.22 }
				icon = { position = { 4 6 } size = { 36 36 } texture = "gfx/interface/icons/estates/nobles_estate.dds" }
				text_single = { position = { 44 4 } size = { 60 20 } text = "RR_EST_NOBLES" align = nobaseline|left }
				text_single = { position = { 44 24 } size = { 60 20 } text = "RR_OPPOSE" align = nobaseline|left }
			}
			widget = {
				size = { 105 72 }
				background = { using = color_mid_red_texture alpha = 0.22 }
				icon = { position = { 4 6 } size = { 36 36 } texture = "gfx/interface/icons/estates/burghers_estate.dds" }
				text_single = { position = { 44 4 } size = { 60 20 } text = "RR_EST_BURGHERS" align = nobaseline|left }
				text_single = { position = { 44 24 } size = { 60 20 } text = "RR_OPPOSE" align = nobaseline|left }
				text_single = { position = { 4 48 } size = { 98 20 } text = "RR_EST_WANTS_S2" fontsize = 12 align = nobaseline|left }
			}
			widget = {
				size = { 105 72 }
				background = { using = color_mid_red_texture alpha = 0.22 }
				icon = { position = { 4 6 } size = { 36 36 } texture = "gfx/interface/icons/estates/peasants_estate.dds" }
