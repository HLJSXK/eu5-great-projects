# Scheme B: ledger. Four selectable rows (three ritual styles + plain) on top; the
# selected row opens a detail sheet with effects, the societal-value axis and every
# estate's reaction. Sample state: style 1 selected. Draft data only.

widget = {
	size = { 462 52 }
	using = bg_text_mask_container_dark_blue
	text_multi = { position = { 10 6 } max_width = 442 autoresize = yes text = "RR_HEADER_TEXT" align = nobaseline|left }
}

# ---------- row 1 (selected)
widget = {
	size = { 462 54 }
	using = bg_paper_card_situations
