				icon = {
					layoutpolicy_horizontal = expanding
					using = button_main_tab_texture
					frame = 4

					modify_texture = {
						using = color_intense_bg_blue_texture
						blend_mode = multiply
					}

					modify_texture = {
						using = overlay_leather_texture
						blend_mode = overlay
						alpha = 0.2
					}

					hbox = {
						margin = { 40 0 }
						margin_top = 8

						icon = {
							size = { 45 45 }
							texture = "gfx/interface/icons/flat_icons/tabicons/europedia_flat_icon.dds"
						}

						text_single = {
							using = layoutpolicy_expanding
							using = Font_Type_Headers
							fontsize = 22
							autoresize = yes
							default_format = "#yellow_titles"
							text = "GP_ENTRY_DRAFT_7"
						}
					}
				}
			}
