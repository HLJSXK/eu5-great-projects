# Great Projects Europedia card style.
#
# Every card in in_game/gui/encyclopedia_lateralview.gui builds from these types. A card is
# 1450 wide: a header tab carrying the title, then a lead paragraph, then sections. A section
# is a heading (icon, gold title, a gold rule fading out to the right) followed by any of:
#
#   tv_eu_text      body text
#   tv_eu_flow      an hbox of tv_eu_step with tv_eu_arrow between (how it works)
#   tv_eu_scale     an hbox of up to seven tv_eu_scale_step (a ladder, weakest to strongest)
#   tv_eu_panel     two side-by-side comparison panels with a tv_eu_sign between them
#   tv_eu_entry     a paper strip: a fixed icon column on the left, a gold title and text right
#   tv_eu_goods_row a fixed label, then tv_eu_item icons in a row
#   tv_eu_anatomy   the Getting Started teaching block: a numbered row of a real control
#                   imitation (tv_eu_mock) and the sentence that explains it
#   tv_eu_index     the Getting Started step index: seven numbered chips across the card
#
# Every icon that names a thing carries a hoverable game link under it (tv_eu_link): the blue
# or golden text a player already knows to hover. Only headings, arrows, medallions and the
# header stand without one. Anatomy rows are inert: nothing inside tv_eu_anatomy is clickable
# except the concept links their own labels already carry.
#
# This file adds a new types group; it does not override a vanilla file, so it cannot conflict
# with another mod.

types tv_europedia_style
{
	# Static catalogue entries. Per-entry height accommodates longer translations.
	type tv_eu_catalogue_entry = widget {
		size = { 1450 300 }
		using = bg_paper_card
		blockoverride "card_color" {
			using = color_intense_bg_blue_texture
			blend_mode = multiply
		}
		widget = {
			size = { 1450 32 }
			background = {
				using = button_main_tab_texture
				frame = 4
				modify_texture = { using = color_intense_bg_blue_texture blend_mode = multiply }
			}
		}
		icon = {
			position = { 12 4 }
			size = { 24 24 }
			texture = "gfx/interface/icons/flat_icons/tabicons/europedia_flat_icon.dds"
			alwaystransparent = yes
		}
	}

	# A whole card: the paper sheet, its header tab and everything under it. Override
	# "card_color" to change the sheet's tint. Everything below this type is a piece of a card.
	type tv_eu_card = vbox {
		set_parent_size_to_minimum = yes
		margin = { 0 10 }

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10
			margin_bottom = 24

			max_width = 1450
			min_width = 1450
			using = bg_paper_card

			blockoverride "card_color" {
				using = color_intense_bg_blue_texture
				blend_mode = multiply
			}

			block "card_header" {}
			block "card_body" {}
		}
	}

	# Lead paragraph: the card's one-paragraph summary, flavour type, centred.
	type tv_eu_lead = text_multi {
		max_width = 1450
		min_width = 1450
		autoresize = yes
		margin = { 140 6 }
		align = hcenter|nobaseline
		using = Font_Type_Flavor
		fontsize = 17
	}

	# Section heading: an icon, a gold title and a gold rule fading out to the right.
	# Override "section_icon" (a texture line) and "section_title" (a text line).
	type tv_eu_section = hbox {
		layoutpolicy_horizontal = expanding
		margin = { 40 0 }
		margin_top = 16
		spacing = 10

		icon = {
			size = { 34 34 }
			block "section_icon" { texture = "gfx/interface/icons/flat_icons/effect.dds" }
		}
		text_single = {
			using = Font_Type_Headers
			fontsize = 19
			default_format = "#yellow_titles"
			autoresize = yes
			block "section_title" { text = "" }
		}
		icon = {
			layoutpolicy_horizontal = expanding
			size = { 20 2 }
			using = color_gold_texture
			alpha = 0.7
			modify_texture = {
				texture = "gfx/interface/component_masks/mask_fade_horizontal_right.dds"
				blend_mode = alphamultiply
			}
		}
	}

	# Body text of a section, indented like the heading.
	type tv_eu_text = text_multi {
		max_width = 1450
		min_width = 1450
		autoresize = yes
		margin = { 40 4 }
	}

	# One step of a flow: a paper panel with an icon, its link caption, a title and a short text.
	# Four steps and three tv_eu_arrow fit a card row (hbox, margin { 40 0 }, spacing 8).
	# europedia_render.py narrows the steps AND their link/body text for longer flows.
	# Override "step_icon", "step_link" (a tv_eu_link naming what the icon shows), "step_title",
	# "step_text".
	type tv_eu_step = vbox {
		minimumsize = { 305 236 }
		maximumsize = { 305 -1 }
		margin = { 14 14 }
		spacing = 8
		using = bg_paper_card

		icon = {
			size = { 60 60 }
			block "step_icon" { texture = "gfx/interface/icons/flat_icons/effect.dds" }
		}
		block "step_link" {}
		text_single = {
			using = Font_Type_Headers
			fontsize = 16
			default_format = "#yellow_titles"
			autoresize = yes
			block "step_title" { text = "" }
		}
		text_multi = {
			max_width = 277
			min_width = 277
			autoresize = yes
			align = hcenter|nobaseline
			block "step_text" { text = "" }
		}
		expand = {}
	}

	# Fixed-position overview card. Text and links remain native GUI widgets.
	type tv_eu_cycle_step = widget {
		using = bg_paper_card
		icon = {
			position = { 14 14 }
			size = { 52 52 }
			block "step_icon" { texture = "gfx/interface/icons/flat_icons/effect.dds" }
		}
		text_single = {
			position = { 80 14 }
			size = { 170 26 }
			autoresize = no
			using = Font_Type_Headers
			fontsize = 18
			default_format = "#yellow_titles"
			block "step_title" { text = "" }
		}
		tv_eu_link = {
			position = { 80 44 }
			min_width = 170
			max_width = 170
			align = left|nobaseline
			block "step_link" { raw_text = "" }
		}
		text_multi = {
			position = { 14 82 }
			min_width = 236
			max_width = 236
			autoresize = yes
			block "step_text" { text = "" }
		}
	}

	# The arrow between two flow steps, and between two items.
	type tv_eu_arrow = icon {
		size = { 30 30 }
		texture = "gfx/interface/buttons/flats/button_simple_right.dds"
		using = color_gold
	}

	# A hoverable game link: [ShowGoodsName('x')|e], [ShowBuildingTypeName('x')|e],
	# [ShowEstateTypeName('x')], [ShowSocietyDirectionName('x')], [ShowModifier('x')] or a
	# concept link. Set raw_text.
	type tv_eu_link = text_multi {
		max_width = 277
		min_width = 277
		autoresize = yes
		align = hcenter|nobaseline
		fontsize = 15
		raw_text = ""
	}

	# An icon with its link caption (fixed 100 wide, icon on top). Override "item_icon"
	# (texture, optionally alpha), "item_size" (the icon's size inside its 48 box) and
	# "item_link".
	type tv_eu_item = vbox {
		minimumsize = { 100 -1 }
		maximumsize = { 100 -1 }
		layoutpolicy_vertical = expanding
		spacing = 4

		widget = {
			size = { 48 48 }
			icon = {
				parentanchor = center
				block "item_size" { size = { 100% 100% } }
				block "item_icon" { texture = "gfx/interface/icons/flat_icons/effect.dds" }
			}
			block "item_overlay" {}
		}
		text_multi = {
			max_width = 100
			min_width = 100
			autoresize = yes
			align = hcenter|nobaseline
			fontsize = 14
			block "item_link" { raw_text = "" }
		}
		expand = {}
	}

	# The arrow between items, level with their icons.
	type tv_eu_item_arrow = vbox {
		layoutpolicy_vertical = expanding
		widget = {
			size = { 30 48 }
			tv_eu_arrow = { parentanchor = center }
		}
		expand = {}
	}

	# One step of a scale (weakest to strongest, left to right): a 64 px medallion over a label.
	# Seven fit a card row (hbox, spacing 10). Override "medallion" (widgets drawn in a 64 x 64
	# box) and "scale_label" (a text line, usually a concept link holding the details).
	type tv_eu_scale_step = vbox {
		minimumsize = { 180 -1 }
		maximumsize = { 180 -1 }
		spacing = 6

		widget = {
			size = { 64 64 }
			block "medallion" {}
		}
		text_multi = {
			max_width = 176
			min_width = 176
			autoresize = yes
			align = hcenter|nobaseline
			block "scale_label" { text = "" }
		}
	}

	# A wide paper panel for side-by-side comparisons: two fit a card row (hbox, margin { 40 0 }),
	# with a tv_eu_sign between them. Override "panel_icons" (tv_eu_item, tv_eu_item_arrow),
	# "panel_title" and "panel_text".
	type tv_eu_panel = vbox {
		minimumsize = { 640 200 }
		maximumsize = { 640 -1 }
		margin = { 18 14 }
		spacing = 8
		using = bg_paper_card

		hbox = {
			spacing = 10
			block "panel_icons" {}
		}
		text_single = {
			using = Font_Type_Headers
			fontsize = 17
			default_format = "#yellow_titles"
			autoresize = yes
			block "panel_title" { text = "" }
		}
		text_multi = {
			max_width = 604
			min_width = 604
			autoresize = yes
			align = hcenter|nobaseline
			block "panel_text" { text = "" }
		}
		expand = {}
	}

	# One of three side-by-side choices (a wonder's dedications): a paper card with an axis icon,
	# a gold title, the flavour text and whatever the caller puts under it. Three fit a card row
	# (hbox, margin { 40 0 }, spacing 10). Override "choice_icon" (a texture line, not a widget),
	# "choice_title", "choice_text" and "choice_extra" (a container of widgets).
	type tv_eu_choice = vbox {
		minimumsize = { 440 -1 }
		maximumsize = { 440 -1 }
		margin = { 16 14 }
		spacing = 8
		using = bg_paper_card

		icon = {
			size = { 48 48 }
			block "choice_icon" { texture = "gfx/interface/icons/flat_icons/effect.dds" }
		}
		text_single = {
			using = Font_Type_Headers
			fontsize = 17
			default_format = "#yellow_titles"
			autoresize = yes
			block "choice_title" { text = "" }
		}
		text_multi = {
			max_width = 408
			min_width = 408
			autoresize = yes
			block "choice_text" { text = "" }
		}
		block "choice_extra" {}
		expand = {}
	}

	# A big gold sign between panels or flow steps ("or", "+", "-", "="). Override "sign_text".
	type tv_eu_sign = text_single {
		minimumsize = { 50 -1 }
		align = hcenter|nobaseline
		using = Font_Type_Headers
		fontsize = 30
		default_format = "#yellow_titles"
		autoresize = yes
		block "sign_text" { raw_text = "" }
	}

	# One entry of a list (a wonder's dedication, a mechanic's rule): a paper strip with a fixed
	# icon column on the left and a gold title over the text on the right. Entries stack in a
	# vbox (margin { 40 0 }, spacing 8). Override "entry_icons", "entry_title", "entry_text".
	type tv_eu_entry = hbox {
		margin = { 18 12 }
		spacing = 20
		using = bg_paper_card

		hbox = {
			minimumsize = { 390 -1 }
			maximumsize = { 390 -1 }
			spacing = 6
			expand = {}
			block "entry_icons" {}
			expand = {}
		}
		vbox = {
			spacing = 4
			text_single = {
				size = { 920 26 }
				align = left|nobaseline
				using = Font_Type_Headers
				fontsize = 17
				default_format = "#yellow_titles"
				autoresize = no
				block "entry_title" { text = "" }
			}
			text_multi = {
				max_width = 920
				min_width = 920
				autoresize = yes
				block "entry_text" { text = "" }
			}
		}
	}

	# tv_eu_entry with room for four items and two arrows. Keep one width per list.
	type tv_eu_entry_wide = hbox {
		margin = { 18 12 }
		spacing = 20
		using = bg_paper_card

		hbox = {
			minimumsize = { 500 -1 }
			maximumsize = { 500 -1 }
			spacing = 6
			expand = {}
			block "entry_icons" {}
			expand = {}
		}
		vbox = {
			spacing = 4
			text_single = {
				size = { 810 26 }
				align = left|nobaseline
				using = Font_Type_Headers
				fontsize = 17
				default_format = "#yellow_titles"
				autoresize = no
				block "entry_title" { text = "" }
			}
			text_multi = {
				max_width = 810
				min_width = 810
				autoresize = yes
				block "entry_text" { text = "" }
			}
		}
	}

	# A labelled row of items: a fixed-width label, then tv_eu_item. Override "row_label" (a text
	# line) and "row_goods".
	type tv_eu_goods_row = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 12

		text_multi = {
			max_width = 230
			min_width = 230
			autoresize = yes
			block "row_label" { text = "" }
		}
		hbox = {
			spacing = 4
			block "row_goods" {}
		}
		expand = {}
	}

	# Bare icons without a link caption: only for decoration that names nothing.
	type tv_eu_goods = icon {
		size = { 40 40 }
	}
	type tv_eu_icon = icon {
		size = { 52 52 }
	}

	# ---------------------------------------------------------------- getting started ----
	#
	# The Getting Started tab does not show screenshots. Each step is one tv_eu_anatomy block:
	# the real control, laid out from the same widgets the Engineering Department panel uses,
	# with a gold number on its left and the sentence that explains it on its right. The player
	# reads "this is the bar, this is what it measures" in one glance instead of cross-reading a
	# picture against a paragraph. Nothing inside the block is clickable; the concept links the
	# labels already carry are the only interactive parts.

	# One numbered anatomy row: a gold number, a fixed control column, then the explanation.
	# The control column is 560 wide so the widest mock (a 470-wide list row plus margin) fits;
	# the explanation takes the remaining 700 of the 1370 body width.
	# Override "row_number", "row_control" (any widget, see tv_eu_mock_*) and "row_note" (a
	# container: each note is a gold title over its sentence, so the slot must be a vbox and not
	# a text line -- a blockoverride in a text widget cannot hold child widgets).
	type tv_eu_anatomy_row = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 16
		margin = { 24 0 }

		text_single = {
			size = { 30 30 }
			alwaystransparent = yes
			background = {
				using = bg_round_corners_frame_alt_texture
				modify_texture = {
					using = color_intense_bg_blue_texture
					blend_mode = multiply
				}
			}
			align = center|nobaseline
			using = Font_Type_Headers
			fontsize = 17
			default_format = "#yellow_titles"
			block "row_number" { raw_text = "" }
		}

		vbox = {
			minimumsize = { 560 -1 }
			maximumsize = { 560 -1 }
			spacing = 6
			block "row_control" {}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			maximumsize = { 700 -1 }
			spacing = 3
			block "row_note" {}
		}
	}

	# The frame a step's controls sit in: the same paper sheet and header strip as a card, at
	# 1370 wide so it lines up with the body text above it. Override "anatomy_title" (a text
	# key) and "anatomy_header_icon".
	type tv_eu_anatomy = vbox {
		minimumsize = { 1370 -1 }
		maximumsize = { 1370 -1 }
		layoutpolicy_horizontal = expanding
		spacing = 4
		margin = { 40 6 }
		using = bg_paper_card
		blockoverride "card_color" {
			using = color_intense_bg_blue_texture
			blend_mode = multiply
		}

		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 30 }
			background = {
				using = button_main_tab_texture
				frame = 4
				modify_texture = {
					using = color_intense_bg_blue_texture
					blend_mode = multiply
				}
			}
			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 40 0 }
				margin_top = 5
				spacing = 8

				icon = {
					size = { 20 20 }
					block "anatomy_header_icon" {
						texture = "gfx/interface/icons/flat_icons/tabicons/europedia_flat_icon.dds"
					}
				}
				text_single = {
					layoutpolicy_horizontal = expanding
					using = Font_Type_Headers
					fontsize = 15
					autoresize = yes
					default_format = "#yellow_titles"
					block "anatomy_title" { text = "" }
				}
			}
		}
		# The rows size the panel. An expanding vertical policy here would let the frame take a
		# neighbour's height instead, clipping the last row; the tips below are dropped instead.
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 2
			margin = { 8 8 }
			block "anatomy_rows" {}
		}
	}

	# A control imitation, sized like the real thing. These are not buttons: they are the shape
	# of a button with the panel's own label on it, so a player recognises it on sight. The
	# caller supplies the text, always an existing panel localization key rather than new prose,
	# so every language already has it. A concept popup is added at the call site as a sibling
	# tooltipmeta, not here: an empty tooltipmeta block would still open an empty tooltip.
	# Override "mock_text".
	type tv_eu_mock_button = button {
		using = button_regular_texture

		text_single = {
			size = { 100% 100% }
			align = center|nobaseline
			autoresize = no
			fontsize = 14
			default_format = "#color_white"
			block "mock_text" { text = "" }
		}
	}

	# The same button in the panel's green (confirm) and yellow (active/attention) variants.
	type tv_eu_mock_button_green = button {
		minimumsize = { 240 32 }
		maximumsize = { 560 32 }
		layoutpolicy_horizontal = expanding
		using = button_regular_texture_alt_green

		text_single = {
			size = { 100% 100% }
			align = center|nobaseline
			autoresize = no
			fontsize = 14
			default_format = "#color_white"
			block "mock_text" { text = "" }
		}
	}

	type tv_eu_mock_button_yellow = button {
		minimumsize = { 240 32 }
		maximumsize = { 560 32 }
		layoutpolicy_horizontal = expanding
		using = button_regular_texture_alt_yellow

		text_single = {
			size = { 100% 100% }
			align = center|nobaseline
			autoresize = no
			fontsize = 14
			default_format = "#color_white"
			block "mock_text" { text = "" }
		}
	}

	type tv_eu_mock_button_red = button {
		minimumsize = { 240 32 }
		maximumsize = { 560 32 }
		layoutpolicy_horizontal = expanding
		using = button_regular_texture_alt_red

		text_single = {
			size = { 100% 100% }
			align = center|nobaseline
			autoresize = no
			fontsize = 14
			default_format = "#color_white"
			block "mock_text" { text = "" }
		}
	}

	# A labelled bar with a fixed value: the shape of a panel progress bar, frozen at the
	# example value in the step text. Override "mock_label", "mock_bar_value", "mock_bar_text"
	# and optionally "mock_bar_progresstexture".
	type tv_eu_mock_bar = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 4

		hbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				block "mock_label" { text = "" }
			}
			text_single = {
				autoresize = yes
				default_format = "#yellow_titles"
				block "mock_bar_text" { raw_text = "" }
			}
		}
		progressbar = {
			size = { -1 16 }
			using = progress_bar_blue_alt
			block "mock_bar_progresstexture" {}
			min = 0
			max = 100
			block "mock_bar_value" { value = 0 }
		}
	}

	# A row of short stat tiles, the shape the Organization and Logistics card uses.
	# Override "mock_stats" with tv_eu_mock_stat cells.
	type tv_eu_mock_stats = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 6
		block "mock_stats" {}
	}

	type tv_eu_mock_stat = vbox {
		minimumsize = { 134 -1 }
		maximumsize = { 134 -1 }
		margin = { 6 5 }
		spacing = 1
		using = bg_text_mask_container_dark_blue

		text_multi = {
			min_width = 122
			max_width = 122
			autoresize = yes
			fontsize = 11
			default_format = "#weak"
			block "mock_stat_label" { text = "" }
		}
		text_single = {
			size = { 122 20 }
			autoresize = yes
			fontsize = 15
			block "mock_stat_value" { raw_text = "" }
		}
	}

	# A row of small pip buttons, the shape the four construction parts use for their units.
	# Override "mock_pips" with tv_eu_mock_pip cells.
	type tv_eu_mock_pips = hbox {
		spacing = 4
		block "mock_pips" {}
	}

	type tv_eu_mock_pip = button {
		size = { 32 26 }
		using = button_regular_texture_alt_green
		text_single = {
			size = { 100% 100% }
			align = center|nobaseline
			autoresize = no
			fontsize = 12
			default_format = "#color_white"
			block "mock_pip_text" { raw_text = "" }
		}
	}

	# The step index across the top of Getting Started: seven numbered chips. Override
	# "index_number", "index_icon", "index_title" and "index_link".
	type tv_eu_index_step = vbox {
		minimumsize = { 186 -1 }
		maximumsize = { 186 -1 }
		margin = { 10 8 }
		spacing = 3
		using = bg_paper_card
		blockoverride "card_color" {
			using = color_intense_bg_blue_texture
			blend_mode = multiply
		}

		hbox = {
			spacing = 6
			icon = {
				size = { 26 26 }
				block "index_icon" {
					texture = "gfx/interface/icons/flat_icons/tabicons/europedia_flat_icon.dds"
				}
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				using = Font_Type_Headers
				fontsize = 14
				autoresize = yes
				default_format = "#yellow_titles"
				block "index_number" { raw_text = "" }
			}
		}
		text_single = {
			size = { 166 20 }
			autoresize = yes
			fontsize = 13
			block "index_title" { text = "" }
		}
		text_multi = {
			min_width = 166
			max_width = 166
			autoresize = yes
			fontsize = 12
			block "index_link" { raw_text = "" }
		}
		expand = {}
	}
}
