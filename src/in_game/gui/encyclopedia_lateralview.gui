vbox = {
	using = layoutpolicy_expanding
	set_parent_dimension_to_minimum = height
	spacing = 4

	vbox = {
		visible = "[Or(GetVariableSystem.HasValue('tv_encyclopedia_filter', 'all'), GetVariableSystem.HasValue('tv_encyclopedia_filter', 'mechanics'))]"
		set_parent_size_to_minimum = yes
		margin = { 0 10 }

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10
			using = bg_paper_card

			blockoverride "card_color" {
				using = color_intense_bg_blue_texture
				blend_mode = multiply
			}

			max_width = 1450
			min_width = 1450

			icon = {
				layoutpolicy_horizontal = expanding
				using = button_main_tab_texture
				frame = 4

				modify_texture = {
					using = color_intense_bg_blue_texture
					blend_mode = multiply
				}

				modify_texture = {
					using = overlay_leather_texture
					blend_mode = overlay
					alpha = 0.2
				}

				hbox = {
					margin = { 40 0 }
					margin_top = 8

					icon = {
						name = "image"
						texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
						size = { 45 45 }
					}

					text_single = {
						name = "title"
						using = layoutpolicy_expanding
						using = Font_Size_Medium
						fontsize = 18
						autoresize = no

						default_format = "#yellow_titles"
						text = "game_concept_tv_engineering_department"
					}
				}
			}

			TooltipScrolledContentSection = {
				blockoverride "section_content" {
					vbox = {
						set_parent_dimension_to_minimum = height
						layoutpolicy_horizontal = expanding

						text_multi = {
							name = "body"
