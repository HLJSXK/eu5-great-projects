# @Override of .eu5-base/reference_game_files/game/in_game/gui/encyclopedia_lateralview.gui
# Adds a "Great Projects" tab with 15 mechanic cards and two worked examples
# (Triumphal Axis and Topkapi Palace), toggled via tv_encyclopedia_active.
# EU5 has no native, data-driven way to register a new Encyclopedia sidebar
# page/category -- this is the only known working pattern, see
# docs/knowledge/risk_cards/europedia.md. This file is hand-maintained; only the
# card list between the TV_ENCYCLOPEDIA_CARDS markers is generated, by
# scripts_engineering_department/in_game/gui/gen_tv_encyclopedia_wonders_cards_gui.py +
# scripts_engineering_department/in_game/gui/merge_tv_encyclopedia_wonders_cards_gui.py.
lateralview_full = {
	name = "encyclopedia_lateralview"

    blockoverride "panel_header" {
        window_header_alt = {
            blockoverride "header_text" {
                text = "HEADING_ENCYCLOPEDIA"
            }
            blockoverride "window_header_alt_color_texture"{
				using = color_default_brown_texture
			}
        }
    }

	blockoverride "panel_content" {
		vbox = {
            vbox = {
                using = layoutpolicy_expanding
                using = bg_main_inner_notabs_alt
                using = window_main_tabs_margin_alt

                hbox = {
                    name = "main"
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding
                    spacing = 20

                    vbox = {
                        min_width = 320
                        max_width = 320

                        margin = { 0 10 }
                        layoutpolicy_vertical = expanding

                        hbox = {
                            layoutpolicy_horizontal = expanding
                            margin_right = 10

                            button_regular = {
                                name = "select_page"
                                layoutpolicy_horizontal = expanding

                                text = "ENCYCLOPEDIA_ALL_PAGES"

                                onclick = "[GetVariableSystem.Clear('tv_encyclopedia_active')]"

                                action_tooltip = {
                                    title = "ENCYCLOPEDIA_ALL_PAGES"
                                    on_action = "[Encyclopedia.ViewAllEntries]"
                                }

                                tooltipwidget = { BasicFunctionalTooltip = {} }

                                modify_texture = {
                                    visible = "[And(ObjectsEqual( Encyclopedia.GetCurrentPage, Encyclopedia.GetAllPage ), Not(GetVariableSystem.HasValue('tv_encyclopedia_active', 'yes')))]"
                                    alpha = 0.1
                                }
                            }
                        }

                        hbox = {
                            layoutpolicy_horizontal = expanding
                            margin_right = 10
                            maximumsize = { -1 35 }

                            button_regular = {
                                name = "tv_select_page"
                                layoutpolicy_horizontal = expanding

                                text = "TV_EU_TAB_TITLE"

                                onclick = "[GetVariableSystem.Set('tv_encyclopedia_active', 'yes')]"

                                action_tooltip = {
                                    title = "TV_EU_TAB_TITLE"
                                    on_action = "[Encyclopedia.ViewAllEntries]"
                                }

                                tooltipwidget = { BasicFunctionalTooltip = {} }

                                modify_texture = {
                                    visible = "[GetVariableSystem.HasValue('tv_encyclopedia_active', 'yes')]"
                                    alpha = 0.1
                                }
                            }
                        }


                        scrollbox = {
                            layoutpolicy_horizontal = expanding
                            layoutpolicy_vertical = expanding

                            blockoverride "scrollbox_content" {
                                fixedgridbox = {
                                    name = "entries"
                                    addcolumn = 100%
                                    addrow = 35
                                    setitemsizefromcell = yes
                                    datamodel = "[Encyclopedia.AccessPages]"

                                    item = {
                                        widget = {
                                            hbox = {
                                                layoutpolicy_horizontal = expanding
                                                margin_right = 10

                                                button_regular = {
                                                    name = "select_page"
                                                    layoutpolicy_horizontal = expanding

                                                    text = "[EncyclopediaPage.GetTitle]"

                                                    onclick = "[GetVariableSystem.Clear('tv_encyclopedia_active')]"

                                                    action_tooltip = {
                                                        title = "ENCYCLOPEDIAGE_OPEN_PAGE"
                                                        on_action = "[GameEncyclopedia.SetCurrentPage( EncyclopediaPage.AccessSelf )]"
                                                    }

                                                    tooltipwidget = { BasicFunctionalTooltip = {} }

                                                    modify_texture = {
                                                        visible = "[And(ObjectsEqual( Encyclopedia.GetCurrentPage, EncyclopediaPage.Self ), Not(GetVariableSystem.HasValue('tv_encyclopedia_active', 'yes')))]"
                                                        alpha = 0.1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        expand = {}
                    }

                    vbox = {
                        name = "current"
                        datacontext = "[Encyclopedia.AccessCurrentPage]"
                        layoutpolicy_horizontal = expanding
                        layoutpolicy_vertical = expanding
                        margin_top = 10
                        spacing = 10

                        vbox = {
                            visible = "[Not(GetVariableSystem.HasValue('tv_encyclopedia_active', 'yes'))]"
                            layoutpolicy_horizontal = expanding
                            layoutpolicy_vertical = expanding
                            spacing = 10

                            hbox = {
                                layoutpolicy_horizontal = expanding
                                margin = { 10 0 }
                                spacing = 5
                                hbox = {
                                    name = "search_controls"
                                    layoutpolicy_horizontal = expanding
                                    margin = { 10 0 }
                                    spacing = 5

                                    using = searchbar_background
                                    using = searchbar_icon

                                    editbox_search_field =	{
                                        min_width = 1300
                                        blockoverride "editbox_properties" {
                                            name = "search_input" # Do not change name, it is referenced from code
                                            onreturnpressed = "[EncyclopediaPage.FilterFromText]"
                                            ontextedited = "[EncyclopediaPage.FilterFromText]"
                                            maxcharacters = 50
                                        }
                                    }

                                    expand = {}
                                }

                                hbox = {
                                    ui_direction_button = {
                                        size = { 22 22 }
                                        enabled = "[NotEqualTo_int32(GameEncyclopedia.GetCurrentSubpageNumber, '(int32)1')]"
                                        action_tooltip = {
                                        	title = "ENCYCLOPEDIA_GO_TO_PREVIOUS_SUBPAGE"
                                        	on_action = "[GameEncyclopedia.GoToPreviousSubPage]"
                                        }
                                        tooltipwidget = { BasicFunctionalTooltip = {} }

                                        mirror = horizontal
                                        texture = "gfx/interface/buttons/flats/button_simple_right.dds"
                                        using = button_regular_icon_color
                                    }

                                    hbox = {
                                        using = bg_number_container_bckg
                                        blockoverride "number_container_extra" {
                                            alpha = 0.4
                                            margin = {4 4}
                                        }

                                        hbox = {
                                            name = "search_controls"
                                            layoutpolicy_horizontal = expanding
                                            margin = { 10 0 }
                                            spacing = 5

                                            using = searchbar_background

                                            editbox_search_field =	{
                                                min_width = 35
                                                blockoverride "editbox_standard_size" {
                                                    size = { 30 30 }
                                                }
                                                blockoverride "editbox_properties" {
                                                    name = "subpage_number" # Do not change name, it is referenced from code
                                                    onreturnpressed = "[GameEncyclopedia.GoToEditBoxSubPage]"
                                                    ontextedited = "[GameEncyclopedia.GoToEditBoxSubPage]"
                                                    maxcharacters = "[GameEncyclopedia.GetCurrentMaxSubpageNumber]"
                                                    text = "[GameEncyclopedia.GetCurrentSubpageNumber]"
                                                }
                                            }

                                            expand = {}
                                        }

                                        text_single = {
                                            size = { 30 30 }
                                            align = center
                                            using = Font_Type_Headers
                                            raw_text = "/[GameEncyclopedia.GetCurrentMaxSubpageNumber]"
                                            autoresize = no
                                        }
                                    }

                                    ui_direction_button = {
                                        size = { 22 22 }
                                        enabled = "[NotEqualTo_int32(GameEncyclopedia.GetCurrentSubpageNumber, GameEncyclopedia.GetCurrentMaxSubpageNumber)]"
                                        action_tooltip = {
                                        	title = "ENCYCLOPEDIA_GO_TO_NEXT_SUBPAGE"
                                        	on_action = "[GameEncyclopedia.GoToNextSubPage]"
                                        }
                                        tooltipwidget = { BasicFunctionalTooltip = {} }

                                        texture = "gfx/interface/buttons/flats/button_simple_right.dds"
                                        using = button_regular_icon_color
                                    }
                                    expand = {}
                                }
                            }


                            scrollbox = {
                                layoutpolicy_horizontal = expanding
                                layoutpolicy_vertical = expanding

                                blockoverride "scrollbox_content" {
                                    dynamicgridbox = {
                                        name = "entries"
                                        datamodel = "[GameEncyclopedia.GetCurrentSubPageViewedEntries]"

                                        item = {
                                            widget = {
                                                vbox = {
                                                    set_parent_size_to_minimum = yes
                                                    margin = { 0 10 }

                                                    vbox = {
                                                        layoutpolicy_horizontal = expanding
                                                        datacontext = "[EncyclopediaEntryView.Get]"
                                                        spacing = 10
                                                        using = bg_paper_card

                                                        blockoverride "card_color" {
                                                            using = color_intense_bg_blue_texture
                                                            blend_mode = multiply
                                                        }

                                                        max_width = 1450
                                                        min_width = 1450

                                                        icon = {
                                                            layoutpolicy_horizontal = expanding
                                                            using = button_main_tab_texture
                                                            frame = 4

                                                            modify_texture = {
                                                                using = color_intense_bg_blue_texture
                                                                blend_mode = multiply
                                                            }

                                                            modify_texture = {
                                                                using = overlay_leather_texture
                                                                blend_mode = overlay
                                                                alpha = 0.2
                                                            }

                                                            hbox = {
                                                                margin = { 40 0 }
                                                                margin_top = 8

                                                                icon = {
                                                                    name = "image"
                                                                    texture = "[EncyclopediaEntry.GetImage]"
                                                                    visible = "[EncyclopediaEntry.HasImage]"
                                                                    size = { 45 45 }
                                                                    framesize = "[EncyclopediaEntry.GetFrameSize]"
                                                                    frame = "[EncyclopediaEntry.GetFrame]"
                                                                }

                                                                text_single = {
                                                                    name = "title"
                                                                    using = layoutpolicy_expanding
                                                                    using = Font_Size_Medium
                                                                    fontsize = 18
                                                                    autoresize = no

                                                                    default_format = "#yellow_titles"
                                                                    text = "[EncyclopediaEntry.GetTitle]"

                                                                }
                                                            }
                                                        }

                                                        TooltipScrolledContentSection = {
                                                            blockoverride "section_content" {
                                                                vbox = {
                                                                    set_parent_dimension_to_minimum = height
                                                                    layoutpolicy_horizontal = expanding

                                                                    text_multi = {
                                                                        name = "body"
                                                                        max_width = 1450
                                                                        min_width = 1450
                                                                        autoresize = yes

                                                                        text = "[EncyclopediaEntry.GetBody]"
                                                                        margin = { 40 10 }
                                                                    }
                                                                }
                                                            }
                                                            block "block_scrollarea" {
                                                                maximumsize = { -1 800 }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                expand = {}
                            }
                        }

                        vbox = {
                            using = layoutpolicy_expanding
                            visible = "[GetVariableSystem.HasValue('tv_encyclopedia_active', 'yes')]"
                            spacing = 10

                            hbox = {
                                layoutpolicy_horizontal = expanding
                                margin = { 10 0 }
                                spacing = 5

                                button_regular = {
                                    name = "tv_filter_all"
                                    layoutpolicy_horizontal = expanding
                                    text = "TV_EU_FILTER_ALL"
                                    tooltip = "TV_EU_FILTER_ALL_TOOLTIP"
                                    onclick = "[GetVariableSystem.Set('tv_encyclopedia_filter', 'all')]"
                                    down = "[GetVariableSystem.HasValue('tv_encyclopedia_filter', 'all')]"
                                }
                                button_regular = {
                                    name = "tv_filter_overview"
                                    layoutpolicy_horizontal = expanding
                                    text = "TV_EU_FILTER_OVERVIEW"
                                    tooltip = "TV_EU_FILTER_OVERVIEW_TOOLTIP"
                                    onclick = "[GetVariableSystem.Set('tv_encyclopedia_filter', 'overview')]"
                                    down = "[GetVariableSystem.HasValue('tv_encyclopedia_filter', 'overview')]"
                                }
                                button_regular = {
                                    name = "tv_filter_mechanics"
                                    layoutpolicy_horizontal = expanding
                                    text = "TV_EU_FILTER_MECHANICS"
                                    tooltip = "TV_EU_FILTER_MECHANICS_TOOLTIP"
                                    onclick = "[GetVariableSystem.Set('tv_encyclopedia_filter', 'mechanics')]"
                                    down = "[Or(Not(GetVariableSystem.Exists('tv_encyclopedia_filter')), GetVariableSystem.HasValue('tv_encyclopedia_filter', 'mechanics'))]"
                                }
                                button_regular = {
                                    name = "tv_filter_unique"
                                    layoutpolicy_horizontal = expanding
                                    text = "TV_EU_FILTER_UNIQUE"
                                    tooltip = "TV_EU_FILTER_UNIQUE_TOOLTIP"
                                    onclick = "[GetVariableSystem.Set('tv_encyclopedia_filter', 'unique')]"
                                    down = "[GetVariableSystem.HasValue('tv_encyclopedia_filter', 'unique')]"
                                }
                                button_regular = {
                                    name = "tv_filter_generic"
                                    layoutpolicy_horizontal = expanding
                                    text = "TV_EU_FILTER_GENERIC"
                                    tooltip = "TV_EU_FILTER_GENERIC_TOOLTIP"
                                    onclick = "[GetVariableSystem.Set('tv_encyclopedia_filter', 'generic')]"
                                    down = "[GetVariableSystem.HasValue('tv_encyclopedia_filter', 'generic')]"
                                }

                                expand = {}
                            }

                            scrollbox = {
                                using = layoutpolicy_expanding

                                blockoverride "scrollbox_content" {
# TV_ENCYCLOPEDIA_CARDS_ANCHOR
# BEGIN GENERATED TV_ENCYCLOPEDIA_CARDS
vbox = {
	using = layoutpolicy_expanding
	set_parent_dimension_to_minimum = height
	spacing = 4

	vbox = {
		visible = "[GetVariableSystem.HasValue('tv_encyclopedia_filter', 'overview')]"
		tv_eu_card = {
			blockoverride "card_header" {
				icon = {
					layoutpolicy_horizontal = expanding
					using = button_main_tab_texture
					frame = 4

					modify_texture = {
						using = color_intense_bg_blue_texture
						blend_mode = multiply
					}

					modify_texture = {
						using = overlay_leather_texture
						blend_mode = overlay
						alpha = 0.2
					}

					hbox = {
						margin = { 40 0 }
						margin_top = 8

						icon = {
							size = { 45 45 }
							texture = "gfx/interface/icons/flat_icons/tabicons/europedia_flat_icon.dds"
						}

						text_single = {
							using = layoutpolicy_expanding
							using = Font_Type_Headers
							fontsize = 22
							autoresize = yes
							default_format = "#yellow_titles"
							text = "TV_EU_OVERVIEW_TITLE"
						}
					}
				}
			}
			blockoverride "card_body" {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 10

			tv_eu_lead = { text = "TV_EU_OVERVIEW_LEAD" }

			tv_eu_section = {
				blockoverride "section_icon" { texture = "gfx/interface/icons/flat_icons/tabicons/advances.dds" }
				blockoverride "section_title" { text = "TV_EU_OVERVIEW_S1_TITLE" }
			}
			hbox = {
				margin = { 40 0 }
				widget = {
				name = "tv_eu_overview_cycle"
				size = { 1370 960 }
				icon = { size = { 1370 960 } texture = "gfx/interface/illustrations/tv_europedia_cycle.dds" alwaystransparent = yes }
				text_single = {
					position = { 565 460 }
					size = { 240 40 }
					autoresize = no align = center
					using = Font_Type_Headers fontsize = 26
					default_format = "#yellow_titles" text = "TV_EU_OVERVIEW_TITLE"
				}
				tv_eu_cycle_step = {
					name = "tv_eu_overview_cycle_step_1"
					position = { 553 0 }
					size = { 264 196 }
					blockoverride "step_icon" { texture = "gfx/interface/icons/flat_icons/tabicons/government.dds" }
					blockoverride "step_link" { raw_text = "[tv_great_engineer|e]" }
					blockoverride "step_title" { text = "TV_EU_OVERVIEW_S1_P1_TITLE" }
					blockoverride "step_text" { text = "TV_EU_OVERVIEW_S1_P1_TEXT" }
				}
				tv_eu_cycle_step = {
					name = "tv_eu_overview_cycle_step_2"
					position = { 852 144 }
					size = { 264 196 }
					blockoverride "step_icon" { texture = "gfx/interface/icons/flat_icons/tabicons/advances.dds" }
					blockoverride "step_link" { raw_text = "[tv_wonder_concept|e]" }
					blockoverride "step_title" { text = "TV_EU_OVERVIEW_S1_P2_TITLE" }
					blockoverride "step_text" { text = "TV_EU_OVERVIEW_S1_P2_TEXT" }
				}
				tv_eu_cycle_step = {
					name = "tv_eu_overview_cycle_step_3"
					position = { 925 467 }
					size = { 264 196 }
					blockoverride "step_icon" { texture = "gfx/interface/icons/flat_icons/estates/estates.dds" }
					blockoverride "step_link" { raw_text = "[tv_wonder_debate|e]" }
					blockoverride "step_title" { text = "TV_EU_OVERVIEW_S1_P3_TITLE" }
					blockoverride "step_text" { text = "TV_EU_OVERVIEW_S1_P3_TEXT" }
				}
				tv_eu_cycle_step = {
					name = "tv_eu_overview_cycle_step_4"
					position = { 719 726 }
					size = { 264 196 }
					blockoverride "step_icon" { texture = "gfx/interface/icons/flat_icons/tabicons/mapmodes.dds" }
					blockoverride "step_link" { raw_text = "[tv_wonder_survey|e]" }
					blockoverride "step_title" { text = "TV_EU_OVERVIEW_S1_P4_TITLE" }
					blockoverride "step_text" { text = "TV_EU_OVERVIEW_S1_P4_TEXT" }
				}
				tv_eu_cycle_step = {
					name = "tv_eu_overview_cycle_step_5"
					position = { 387 726 }
					size = { 264 196 }
					blockoverride "step_icon" { texture = "gfx/interface/icons/flat_icons/estates_enrichment.dds" }
					blockoverride "step_link" { raw_text = "[tv_wonder_organization_competence|e] / [tv_wonder_logistics_competence|e]" }
					blockoverride "step_title" { text = "TV_EU_OVERVIEW_S1_P5_TITLE" }
					blockoverride "step_text" { text = "TV_EU_OVERVIEW_S1_P5_TEXT" }
				}
				tv_eu_cycle_step = {
					name = "tv_eu_overview_cycle_step_6"
					position = { 181 467 }
					size = { 264 196 }
					blockoverride "step_icon" { texture = "gfx/interface/icons/flat_icons/building_panel/build.dds" }
					blockoverride "step_link" { raw_text = "[tv_wonder_construction|e]" }
					blockoverride "step_title" { text = "TV_EU_OVERVIEW_S1_P6_TITLE" }
					blockoverride "step_text" { text = "TV_EU_OVERVIEW_S1_P6_TEXT" }
				}
				tv_eu_cycle_step = {
					name = "tv_eu_overview_cycle_step_7"
					position = { 254 144 }
					size = { 264 196 }
					blockoverride "step_icon" { texture = "gfx/interface/icons/flat_icons/hre_parliament.dds" }
					blockoverride "step_link" { raw_text = "[tv_wonder_ceremony|e]" }
					blockoverride "step_title" { text = "TV_EU_OVERVIEW_S1_P7_TITLE" }
					blockoverride "step_text" { text = "TV_EU_OVERVIEW_S1_P7_TEXT" }
				}
				}
			}
			tv_eu_text = { min_width = 1370 max_width = 1370 text = "TV_EU_OVERVIEW_S1_NOTE" }

vbox = { name = "tv_eu_overview_guide_1"
minimumsize = { 1450 -1 } maximumsize = { 1450 -1 } layoutpolicy_horizontal = expanding spacing = 10
			tv_eu_section = {
				blockoverride "section_icon" { texture = "gfx/interface/icons/flat_icons/tabicons/government.dds" }
				blockoverride "section_title" { text = "TV_EU_OVERVIEW_S2_TITLE" }
			}
			tv_eu_text = { min_width = 1370 max_width = 1370 text = "TV_EU_OVERVIEW_S2_BODY" }
tv_eu_anatomy = {
	blockoverride "anatomy_header_icon" { texture = "gfx/interface/icons/flat_icons/tabicons/government.dds" }
	blockoverride "anatomy_title" { text = "TV_ENGINEERING_GREAT_ENGINEER_CARD_TITLE" }
	blockoverride "anatomy_rows" {
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10
			tv_eu_anatomy_row = {
				blockoverride "row_number" { raw_text = "1" }
				blockoverride "row_control" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4
						widget = {
							minimumsize = { 360 32 }
							maximumsize = { 560 32 }
							layoutpolicy_horizontal = expanding
							using = bg_text_mask_container_dark_blue
							text_single = {
								size = { 100% 100% }
								align = center|nobaseline
								autoresize = no
								default_format = "#high"
								text = "TV_ENGINEERING_HEADER_STATUS_NO_ENGINEER"
							}
						}
					}
				}
				blockoverride "row_note" {
					vbox = {
						spacing = 3
						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = yes
							using = Font_Type_Headers
							fontsize = 16
							default_format = "#yellow_titles"
							text = "TV_EU_OVERVIEW_S2_R1_TITLE"
						}
						text_multi = {
							min_width = 700
							max_width = 700
							autoresize = yes
							text = "TV_EU_OVERVIEW_S2_R1_TEXT"
						}
					}
				}
			}
			tv_eu_anatomy_row = {
				blockoverride "row_number" { raw_text = "2" }
				blockoverride "row_control" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4
						widget = {
							size = { 250 150 }
							using = bg_text_mask_container_dark_blue
							vbox = {
								size = { 250 150 }
								spacing = 2
								expand = {}
								text_single = {
									size = { 250 44 }
									raw_text = "+"
									fontsize = 34
									align = center|nobaseline
									default_format = "#yellow_titles"
								}
								text_single = {
									size = { 250 20 }
									fontsize = 14
									align = center|nobaseline
									default_format = "#high"
									text = "TV_IO_HEADER_APPOINT_CHIEF_PROMPT"
								}
								expand = {}
							}
						}
					}
				}
				blockoverride "row_note" {
					vbox = {
						spacing = 3
						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = yes
							using = Font_Type_Headers
							fontsize = 16
							default_format = "#yellow_titles"
							text = "TV_EU_OVERVIEW_S2_R2_TITLE"
						}
						text_multi = {
							min_width = 700
							max_width = 700
							autoresize = yes
							text = "TV_EU_OVERVIEW_S2_R2_TEXT"
						}
					}
				}
			}
			tv_eu_anatomy_row = {
				margin_bottom = 0
				blockoverride "row_number" { raw_text = "3" }
				blockoverride "row_control" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4
						widget = {
							size = { 400 32 }
							tv_eu_mock_button_yellow = {
								blockoverride "mock_text" { text = "TV_ENGINEERING_CHANGE_LEADER_SHORT" }
							}
						}
						widget = {
							size = { 400 32 }
							tv_eu_mock_button_red = {
								blockoverride "mock_text" { text = "TV_ENGINEERING_REMOVE_LEADER_SHORT" }
							}
						}
					}
				}
				blockoverride "row_note" {
					vbox = {
						spacing = 3
						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = yes
							using = Font_Type_Headers
							fontsize = 16
							default_format = "#yellow_titles"
							text = "TV_EU_OVERVIEW_S2_R3_TITLE"
						}
						text_multi = {
							min_width = 700
							max_width = 700
							autoresize = yes
							text = "TV_EU_OVERVIEW_S2_R3_TEXT"
						}
					}
				}
			}
		}
	}
}
}

vbox = { name = "tv_eu_overview_guide_2"
minimumsize = { 1450 -1 } maximumsize = { 1450 -1 } layoutpolicy_horizontal = expanding spacing = 10
			tv_eu_section = {
				blockoverride "section_icon" { texture = "gfx/interface/icons/flat_icons/tabicons/advances.dds" }
				blockoverride "section_title" { text = "TV_EU_OVERVIEW_S3_TITLE" }
			}
