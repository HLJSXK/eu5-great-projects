# @Override of .eu5-base/reference_game_files/game/in_game/gui/encyclopedia_lateralview.gui
# Adds a "Towards Victory" tab (Engineering Department mechanics + Generic/Unique
# Wonder cards) toggled via the tv_encyclopedia_active GetVariableSystem variable.
# EU5 has no native, data-driven way to register a new Encyclopedia sidebar
# page/category -- this is the only known working pattern, see
# docs/knowledge/risk_cards/europedia.md. This file is hand-maintained; only the
# card list between the TV_ENCYCLOPEDIA_CARDS markers is generated, by
# scripts_engineering_department/in_game/gui/gen_tv_encyclopedia_wonders_cards_gui.py +
# scripts_engineering_department/in_game/gui/merge_tv_encyclopedia_wonders_cards_gui.py.
lateralview_full = {
	name = "encyclopedia_lateralview"

    blockoverride "panel_header" {
        window_header_alt = {
            blockoverride "header_text" {
                text = "HEADING_ENCYCLOPEDIA"
            }
            blockoverride "window_header_alt_color_texture"{
				using = color_default_brown_texture
			}
        }
    }

	blockoverride "panel_content" {
		vbox = {
            vbox = {
                using = layoutpolicy_expanding
                using = bg_main_inner_notabs_alt
                using = window_main_tabs_margin_alt

                hbox = {
                    name = "main"
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding
                    spacing = 20

                    vbox = {
                        min_width = 320
                        max_width = 320

                        margin = { 0 10 }
                        layoutpolicy_vertical = expanding

                        hbox = {
                            layoutpolicy_horizontal = expanding
                            margin_right = 10

                            button_regular = {
                                name = "select_page"
                                layoutpolicy_horizontal = expanding

                                text = "ENCYCLOPEDIA_ALL_PAGES"

                                onclick = "[GetVariableSystem.Clear('tv_encyclopedia_active')]"

                                action_tooltip = {
                                    title = "ENCYCLOPEDIA_ALL_PAGES"
                                    on_action = "[Encyclopedia.ViewAllEntries]"
                                }

                                tooltipwidget = { BasicFunctionalTooltip = {} }

                                modify_texture = {
                                    visible = "[And(ObjectsEqual( Encyclopedia.GetCurrentPage, Encyclopedia.GetAllPage ), Not(GetVariableSystem.HasValue('tv_encyclopedia_active', 'yes')))]"
                                    alpha = 0.1
                                }
                            }
                        }

                        hbox = {
                            layoutpolicy_horizontal = expanding
                            margin_right = 10
                            maximumsize = { -1 35 }

                            button_regular = {
                                name = "tv_select_page"
                                layoutpolicy_horizontal = expanding

                                text = "TV_ENCYCLOPEDIA_TAB_TITLE"

                                onclick = "[GetVariableSystem.Set('tv_encyclopedia_active', 'yes')]"

                                action_tooltip = {
                                    title = "TV_ENCYCLOPEDIA_TAB_TITLE"
                                    on_action = "[Encyclopedia.ViewAllEntries]"
                                }

                                tooltipwidget = { BasicFunctionalTooltip = {} }

                                modify_texture = {
                                    visible = "[GetVariableSystem.HasValue('tv_encyclopedia_active', 'yes')]"
                                    alpha = 0.1
                                }
                            }
                        }


                        scrollbox = {
                            layoutpolicy_horizontal = expanding
                            layoutpolicy_vertical = expanding

                            blockoverride "scrollbox_content" {
                                fixedgridbox = {
                                    name = "entries"
                                    addcolumn = 100%
                                    addrow = 35
                                    setitemsizefromcell = yes
                                    datamodel = "[Encyclopedia.AccessPages]"

                                    item = {
                                        widget = {
                                            hbox = {
                                                layoutpolicy_horizontal = expanding
                                                margin_right = 10

                                                button_regular = {
                                                    name = "select_page"
                                                    layoutpolicy_horizontal = expanding

                                                    text = "[EncyclopediaPage.GetTitle]"

                                                    onclick = "[GetVariableSystem.Clear('tv_encyclopedia_active')]"

                                                    action_tooltip = {
                                                        title = "ENCYCLOPEDIAGE_OPEN_PAGE"
                                                        on_action = "[GameEncyclopedia.SetCurrentPage( EncyclopediaPage.AccessSelf )]"
                                                    }

                                                    tooltipwidget = { BasicFunctionalTooltip = {} }

                                                    modify_texture = {
                                                        visible = "[And(ObjectsEqual( Encyclopedia.GetCurrentPage, EncyclopediaPage.Self ), Not(GetVariableSystem.HasValue('tv_encyclopedia_active', 'yes')))]"
                                                        alpha = 0.1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        expand = {}
                    }

                    vbox = {
                        name = "current"
                        datacontext = "[Encyclopedia.AccessCurrentPage]"
                        layoutpolicy_horizontal = expanding
                        layoutpolicy_vertical = expanding
                        margin_top = 10
                        spacing = 10

                        vbox = {
                            visible = "[Not(GetVariableSystem.HasValue('tv_encyclopedia_active', 'yes'))]"
                            layoutpolicy_horizontal = expanding
                            layoutpolicy_vertical = expanding
                            spacing = 10

                            hbox = {
                                layoutpolicy_horizontal = expanding
                                margin = { 10 0 }
                                spacing = 5
                                hbox = {
                                    name = "search_controls"
                                    layoutpolicy_horizontal = expanding
                                    margin = { 10 0 }
                                    spacing = 5

                                    using = searchbar_background
                                    using = searchbar_icon

                                    editbox_search_field =	{
                                        min_width = 1300
                                        blockoverride "editbox_properties" {
                                            name = "search_input" # Do not change name, it is referenced from code
                                            onreturnpressed = "[EncyclopediaPage.FilterFromText]"
                                            ontextedited = "[EncyclopediaPage.FilterFromText]"
                                            maxcharacters = 50
                                        }
                                    }

                                    expand = {}
                                }

                                hbox = {
                                    ui_direction_button = {
                                        size = { 22 22 }
                                        enabled = "[NotEqualTo_int32(GameEncyclopedia.GetCurrentSubpageNumber, '(int32)1')]"
                                        action_tooltip = {
                                        	title = "ENCYCLOPEDIA_GO_TO_PREVIOUS_SUBPAGE"
                                        	on_action = "[GameEncyclopedia.GoToPreviousSubPage]"
                                        }
                                        tooltipwidget = { BasicFunctionalTooltip = {} }

                                        mirror = horizontal
                                        texture = "gfx/interface/buttons/flats/button_simple_right.dds"
                                        using = button_regular_icon_color
                                    }

                                    hbox = {
                                        using = bg_number_container_bckg
                                        blockoverride "number_container_extra" {
                                            alpha = 0.4
                                            margin = {4 4}
                                        }

                                        hbox = {
                                            name = "search_controls"
                                            layoutpolicy_horizontal = expanding
                                            margin = { 10 0 }
                                            spacing = 5

                                            using = searchbar_background

                                            editbox_search_field =	{
                                                min_width = 35
                                                blockoverride "editbox_standard_size" {
                                                    size = { 30 30 }
                                                }
                                                blockoverride "editbox_properties" {
                                                    name = "subpage_number" # Do not change name, it is referenced from code
                                                    onreturnpressed = "[GameEncyclopedia.GoToEditBoxSubPage]"
                                                    ontextedited = "[GameEncyclopedia.GoToEditBoxSubPage]"
                                                    maxcharacters = "[GameEncyclopedia.GetCurrentMaxSubpageNumber]"
                                                    text = "[GameEncyclopedia.GetCurrentSubpageNumber]"
                                                }
                                            }

                                            expand = {}
                                        }

                                        text_single = {
                                            size = { 30 30 }
                                            align = center
                                            using = Font_Type_Headers
                                            raw_text = "/[GameEncyclopedia.GetCurrentMaxSubpageNumber]"
                                            autoresize = no
                                        }
                                    }

                                    ui_direction_button = {
                                        size = { 22 22 }
                                        enabled = "[NotEqualTo_int32(GameEncyclopedia.GetCurrentSubpageNumber, GameEncyclopedia.GetCurrentMaxSubpageNumber)]"
                                        action_tooltip = {
                                        	title = "ENCYCLOPEDIA_GO_TO_NEXT_SUBPAGE"
                                        	on_action = "[GameEncyclopedia.GoToNextSubPage]"
                                        }
                                        tooltipwidget = { BasicFunctionalTooltip = {} }

                                        texture = "gfx/interface/buttons/flats/button_simple_right.dds"
                                        using = button_regular_icon_color
                                    }
                                    expand = {}
                                }
                            }


                            scrollbox = {
                                layoutpolicy_horizontal = expanding
                                layoutpolicy_vertical = expanding

                                blockoverride "scrollbox_content" {
                                    dynamicgridbox = {
                                        name = "entries"
                                        datamodel = "[GameEncyclopedia.GetCurrentSubPageViewedEntries]"

                                        item = {
                                            widget = {
                                                vbox = {
                                                    set_parent_size_to_minimum = yes
                                                    margin = { 0 10 }

                                                    vbox = {
                                                        layoutpolicy_horizontal = expanding
                                                        datacontext = "[EncyclopediaEntryView.Get]"
                                                        spacing = 10
                                                        using = bg_paper_card

                                                        blockoverride "card_color" {
                                                            using = color_intense_bg_blue_texture
                                                            blend_mode = multiply
                                                        }

                                                        max_width = 1450
                                                        min_width = 1450

                                                        icon = {
                                                            layoutpolicy_horizontal = expanding
                                                            using = button_main_tab_texture
                                                            frame = 4

                                                            modify_texture = {
                                                                using = color_intense_bg_blue_texture
                                                                blend_mode = multiply
                                                            }

                                                            modify_texture = {
                                                                using = overlay_leather_texture
                                                                blend_mode = overlay
                                                                alpha = 0.2
                                                            }

                                                            hbox = {
                                                                margin = { 40 0 }
                                                                margin_top = 8

                                                                icon = {
                                                                    name = "image"
                                                                    texture = "[EncyclopediaEntry.GetImage]"
                                                                    visible = "[EncyclopediaEntry.HasImage]"
                                                                    size = { 45 45 }
                                                                    framesize = "[EncyclopediaEntry.GetFrameSize]"
                                                                    frame = "[EncyclopediaEntry.GetFrame]"
                                                                }

                                                                text_single = {
                                                                    name = "title"
                                                                    using = layoutpolicy_expanding
                                                                    using = Font_Size_Medium
                                                                    fontsize = 18
                                                                    autoresize = no

                                                                    default_format = "#yellow_titles"
                                                                    text = "[EncyclopediaEntry.GetTitle]"

                                                                }
                                                            }
                                                        }

                                                        TooltipScrolledContentSection = {
                                                            blockoverride "section_content" {
                                                                vbox = {
                                                                    set_parent_dimension_to_minimum = height
                                                                    layoutpolicy_horizontal = expanding

                                                                    text_multi = {
                                                                        name = "body"
                                                                        max_width = 1450
                                                                        min_width = 1450
                                                                        autoresize = yes

                                                                        text = "[EncyclopediaEntry.GetBody]"
                                                                        margin = { 40 10 }
                                                                    }
                                                                }
                                                            }
                                                            block "block_scrollarea" {
                                                                maximumsize = { -1 800 }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                expand = {}
                            }
                        }

                        vbox = {
                            using = layoutpolicy_expanding
                            visible = "[GetVariableSystem.HasValue('tv_encyclopedia_active', 'yes')]"
                            spacing = 10

                            hbox = {
                                layoutpolicy_horizontal = expanding
                                margin = { 10 0 }
                                spacing = 5

                                button_regular = {
                                    name = "tv_filter_all"
                                    layoutpolicy_horizontal = expanding
                                    text = "TV_ENCYCLOPEDIA_FILTER_ALL"
                                    tooltip = "TV_ENCYCLOPEDIA_FILTER_ALL_TOOLTIP"
                                    onclick = "[GetVariableSystem.Set('tv_encyclopedia_filter', 'all')]"
                                    down = "[GetVariableSystem.HasValue('tv_encyclopedia_filter', 'all')]"
                                }
                                button_regular = {
                                    name = "tv_filter_mechanics"
                                    layoutpolicy_horizontal = expanding
                                    text = "TV_ENCYCLOPEDIA_FILTER_MECHANICS"
                                    tooltip = "TV_ENCYCLOPEDIA_FILTER_MECHANICS_TOOLTIP"
                                    onclick = "[GetVariableSystem.Set('tv_encyclopedia_filter', 'mechanics')]"
                                    down = "[GetVariableSystem.HasValue('tv_encyclopedia_filter', 'mechanics')]"
                                }
                                button_regular = {
                                    name = "tv_filter_generic"
                                    layoutpolicy_horizontal = expanding
                                    text = "TV_ENCYCLOPEDIA_FILTER_GENERIC"
                                    tooltip = "TV_ENCYCLOPEDIA_FILTER_GENERIC_TOOLTIP"
                                    onclick = "[GetVariableSystem.Set('tv_encyclopedia_filter', 'generic')]"
                                    down = "[GetVariableSystem.HasValue('tv_encyclopedia_filter', 'generic')]"
                                }
                                button_regular = {
                                    name = "tv_filter_unique"
                                    layoutpolicy_horizontal = expanding
                                    text = "TV_ENCYCLOPEDIA_FILTER_UNIQUE"
                                    tooltip = "TV_ENCYCLOPEDIA_FILTER_UNIQUE_TOOLTIP"
                                    onclick = "[GetVariableSystem.Set('tv_encyclopedia_filter', 'unique')]"
                                    down = "[GetVariableSystem.HasValue('tv_encyclopedia_filter', 'unique')]"
                                }

                                expand = {}
                            }

                            scrollbox = {
                                using = layoutpolicy_expanding

                                blockoverride "scrollbox_content" {
