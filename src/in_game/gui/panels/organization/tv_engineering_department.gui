					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					margin = { 10 4 }
					vbox = {
						size = { 236 72 }
						layoutpolicy_horizontal = fixed
						layoutpolicy_vertical = fixed
						ignoreinvisible = yes
						spacing = 4

						text_single = {
							visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet)]"
							text = "TV_ENGINEERING_HEADER_NEXT_NO_ENGINEER"
							fontsize = 14
							align = nobaseline|left
						}
						text_single = {
							visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_concept_in_progress').IsSet)]"
							text = "TV_ENGINEERING_HEADER_NEXT_CONCEPT"
							fontsize = 14
							align = nobaseline|left
						}
						text_single = {
							visible = "[And(And(And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, LessThan_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)1.0'), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').IsSet)), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_slot_1').IsSet)), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_concept_in_progress').IsSet))]"
							text = "TV_ENGINEERING_HEADER_NEXT_NO_PROPOSAL"
							fontsize = 14
							align = nobaseline|left
						}
						text_single = {
							visible = "[And(And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, LessThan_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)1.0'), Or(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_slot_1').IsSet)), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_concept_in_progress').IsSet))]"
							text = "TV_ENGINEERING_HEADER_NEXT_PROPOSAL"
							fontsize = 14
							align = nobaseline|left
						}
						text_single = {
							visible = "[And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').IsSet, EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)1.0'))]"
							text = "TV_ENGINEERING_HEADER_NEXT_DEBATE"
							fontsize = 14
							align = nobaseline|left
						}
						text_single = {
							visible = "[And(And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_survey_complete').IsSet)), And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').IsSet, GreaterThanOrEqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)2.0'), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet)))]"
							text = "TV_ENGINEERING_HEADER_NEXT_SURVEY"
