			tv_engineering_department_card_common = {
				visible = "[GreaterThanOrEqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)1.0')]"
				maximumsize = { 500 -1 }

				blockoverride "common_header_text" {
					text = "TV_ENGINEERING_CONCEPT_ACTIONS_TITLE"
				}
				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
				}

				blockoverride "header_help_tooltip" {
					tooltipwidget = {
						ConceptTooltipType = {
							blockoverride "title_icon" {
								icon = {
									texture = "gfx/interface/icons/flat_icons/tabicons/europedia_flat_icon.dds"
									using = tooltip_title_icon_size
								}
							}

							blockoverride "title_text" {
								text = "TV_ENGINEERING_CONCEPT_ACTIONS_TITLE"
							}

							blockoverride "tooltip_content" {
								vbox = {
									set_parent_size_to_minimum = yes
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = shrinking
									spacing = 6

