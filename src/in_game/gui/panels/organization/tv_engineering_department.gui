	blockoverride "country_header_names_visible" {
		visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
	}
	blockoverride "country_header_character_name" {
		datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').GetCharacter]"
		margin = { 2 0 }
		character_label_name = {
			margin_left = 0
			margin_right = 10
			blockoverride "character_name_text" {
				raw_text = "[Character.GetNameToFit('(int32)40', '(bool)yes')]"
			}
		}
	}
	blockoverride "character_widget" {
		widget = {
			position = { 0 -30 }
			allow_outside = yes
			block "portrait_io_widget" {
				size = { 250 200 }
			}

			block "character_portrait_anchor" {
				parentanchor = bottom
			}

			portrait_standard_full_body_center_button = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
				block "character_right_visible" {
					visible = yes
				}
				parentanchor = bottom

				size = { 250 200 }
				datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').GetCharacter]"
			}

			vbox = {
				visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet)]"
				size = { 250 200 }
				parentanchor = center
				widgetanchor = center
				position = { 0 0 }
				spacing = 2

				expand = {}
				spacer = { size = { 250 50 } }
				text_single = {
					size = { 250 30 }
					raw_text = "+"
					fontsize = 34
					align = center|nobaseline
					default_format = "#yellow_titles"
				}
				text_single = {
					size = { 250 20 }
					text = "TV_IO_HEADER_APPOINT_CHIEF_PROMPT"
					fontsize = 14
					align = center|nobaseline
					default_format = "#high"
				}
				expand = {}
			}

			button_regular = {
				visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet)]"
				size = { 250 200 }
				parentanchor = center
				widgetanchor = center
				position = { 0 0 }
				alpha = 0
				alwaystransparent = no
				enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
				scripted_action_tooltip = { click_type = left click_mode = single action_name = "tv_appoint_engineering_leader" actor = "[InternationalOrganizationsView.GetPlayer]" } button_tooltip_override = { title = "tv_appoint_engineering_leader" description = "tv_appoint_engineering_leader_desc" } tooltipwidget = { using = action_tooltip_pop_out }
			}

			button_regular = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
				size = { 78 26 }
				parentanchor = top|right
				widgetanchor = top|right
				position = { 0 20 }
				using = button_regular_texture_alt_yellow
				using = button_common_textobj_template
				fontsize = 13
				text = "TV_ENGINEERING_CHANGE_LEADER_SHORT"
				enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
				scripted_action_tooltip = { click_type = left click_mode = single action_name = "tv_change_engineering_leader" actor = "[InternationalOrganizationsView.GetPlayer]" } button_tooltip_override = { title = "tv_change_engineering_leader" description = "tv_change_engineering_leader_desc" } tooltipwidget = { using = action_tooltip_pop_out }
