text_single = { visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_ritual_in_progress').IsSet)]" text = "TV_ENGINEERING_HEADER_NEXT_RITUAL_PROGRESS" fontsize = 14 align = nobaseline|left }
