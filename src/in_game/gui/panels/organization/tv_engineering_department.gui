# Towards Victory - Engineering Department IO Panel
# Overview tab: status, conception, and debate.
# Header: Great Engineer appointment, replacement, and dismissal.
# Resolutions tab: survey, organization, and logistics.
# Custom tab: construction and ceremony.

# BEGIN GENERATED TV_WONDER_RITUAL_TYPES
types TVWonderRitualTypes {
type tv_wonder_ritual_supporter = widget {
size = { 36 36 }
alwaystransparent = no
icon = { size = { 32 32 } alwaystransparent = yes block "estate_icon" {} }
icon = {
name = "support_badge"
position = { 20 20 } size = { 16 16 }
texture = "gfx/interface/icons/text_icons/trigger_yes.dds"
alwaystransparent = yes
}
}
}
# END GENERATED TV_WONDER_RITUAL_TYPES

types EngineeringDepartmentTypes
{
	type tv_engineering_department_card_common = hbox {
		layoutpolicy_horizontal = expanding
		vbox = {
			layoutpolicy_horizontal = expanding

			block "card_bg" {
				using = bg_paper_card_situations
			}

			widget = {
				layoutpolicy_horizontal = expanding
				block "header_size" {
					size = {-1 50}
				}

				block "header_decor_templates" {
					using = bg_geodiplo_situation_header_secondary
				}

				block "common_header_back_decor" {}
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					block "common_header_margin" {}
					block "common_header_extra_left" {
						spacer = { size = { 50 -1 } }
						expand = {}
					}
					block "common_header" {
						block "common_header_icon" {
							icon = {
								size = { 30 30 }
								block "common_header_icon_texture" {
									texture = "gfx/interface/icons/religious_doctrines/catholic/religious_actions.dds"
								}
								texture_density = 2
								using = overlay_color_light_blue
								alpha = 1
							}
						}
						block "common_header_text_full" {
							text_single = {
								block "common_header_text" {
									raw_text = "Card title header"
								}
							}
						}
						block "common_header_text_expand" {}
					}
					block "common_header_extra_right" {
						expand = {}
						button_regular = {
							size = { 32 32 }
							margin = { 6 0 }

							icon = {
								size = { 30 30 }
								parentanchor = center
								texture = "gfx/interface/icons/flat_icons/tabicons/europedia_flat_icon.dds"
							}

							action_tooltip = {
								click_type = left
								click_mode = single
								title = "OPEN_EUROPEDIA"
								on_action = "[OpenLateralView('encyclopedia')]"
							}

							block "header_help_tooltip" {
								tooltipwidget = {
									ConceptTooltipType = {
										blockoverride "title_icon" {
											icon = {
												texture = "gfx/interface/icons/flat_icons/tabicons/europedia_flat_icon.dds"
												using = tooltip_title_icon_size
											}
										}

										blockoverride "title_text" {
											text = "Card title header"
										}

										blockoverride "tooltip_content" {
											vbox = {
												set_parent_size_to_minimum = yes
												layoutpolicy_horizontal = expanding
												layoutpolicy_vertical = shrinking
												spacing = 6
											}
										}
									}
								}
							}
						}
						spacer = { size = { 20 -1 } }
					}
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4
				block "card_common_bottom_margin" {
					margin = {15 10}
				}
				block "common_bottom_content" {
					icon = {
						size = { 30 30 }
						texture = "gfx/interface/icons/religious_doctrines/catholic/religious_actions.dds"
						texture_density = 2
					}
					text_single = {
						raw_text = "Card content text"
					}
					expand = {}
				}
			}

			expand = {}
		}
	}

	# BEGIN GENERATED TV_WONDER_MECHANICS_SUITABILITY_LOCATION_CONDITIONS_TYPE
	type tv_engineering_suitability_location_conditions_column = vbox {
		layoutpolicy_horizontal = fixed
		layoutpolicy_vertical = expanding
		minimumsize = { 218 -1 }
		maximumsize = { 218 -1 }
		ignoreinvisible = yes
		spacing = 3
		text_single = { text = "TV_ENGINEERING_SUITABILITY_LOCATION_CONDITIONS_TITLE" max_width = 218 fontsize = 13 align = nobaseline|left }
		TooltipRequirementsList = {
			layoutpolicy_horizontal = fixed
			textcontext = "[ShowTriggerConditions('tv_wonder_site_rule_player_visible_locked_wonder_trigger', PlayerScope.Self)]"
			maximumsize = { 218 -1 }
			blockoverride "tooltip_minimumsize" { minimumsize = { 218 -1 } }
			blockoverride "field_text_format" {
				fontsize = 13
			}
			blockoverride "row_size" {
				maximumsize = { -1 22 }
				minimumsize = { -1 22 }
			}
			blockoverride "block_title" {
				block "block_title" {
					visible = no
				}
			}
			blockoverride "requirementslist_datamodel_is_empty" {
				visible = no
			}
		}
		expand = {}
	}
	# END GENERATED TV_WONDER_MECHANICS_SUITABILITY_LOCATION_CONDITIONS_TYPE
}

organization_panel = {

	state = {
		name = _show
		on_start = "[PdxGuiWidget.PushMapModeOverride('tv_wonder')]"
	}

	state = {
		name = _hide
		on_start = "[PdxGuiWidget.PopMapModeOverride]"
	}

	blockoverride "organization_overview_tab_visible" {}

	blockoverride "organization_panel_overview_visible" {
		visible = "[InternationalOrganizationsView.Vars.NotExistOrHasValue( 'organizations', 'overview' )]"
	}

	blockoverride "organization_members_tab_visible" {
		visible = no
	}

	blockoverride "organization_members_tab_down" {
		down = no
	}

	blockoverride "organization_panel_members_visible" {
		visible = no
	}

	blockoverride "scroll_overview_empty_visible" { visible = no }

	blockoverride "country_header_character_visible" {
		visible = yes
	}
	blockoverride "country_header_religion" {}
	blockoverride "extra_titles" {}
	blockoverride "organization_panel_extra_item" {
		widget = {
			size = { 260 120 }
			parentanchor = top|right
			widgetanchor = top|right
			position = { -12 6 }
			allow_outside = yes

			vbox = {
				layoutpolicy_horizontal = fixed
				layoutpolicy_vertical = fixed
				minimumsize = { 260 120 }
				maximumsize = { 260 120 }
				using = bg_paper_card_situations

				widget = {
					layoutpolicy_horizontal = expanding
					size = {-1 42}
					using = bg_geodiplo_situation_header_secondary

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4
						expand = {}
						icon = {
							size = { 30 30 }
							texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
							texture_density = 2
							using = overlay_color_light_blue
							alpha = 1
						}
						text_single = {
							text = "TV_ENGINEERING_CURRENT_GUIDANCE_CARD_TITLE"
