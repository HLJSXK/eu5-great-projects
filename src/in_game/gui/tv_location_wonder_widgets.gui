types tv_location_wonder_widgets {
	type tv_location_wonders_button = header_button_left {
		name = "tv_location_wonders_button"
		datacontext = "[LocationView.GetLocation]"
		visible = "[LocationView.GetLocation.MakeScope.GetVariable('tv_wonder_tooltip_slot_1_id').IsSet]"
		size = { 108 30 }
		parentanchor = top|right
		widgetanchor = top|right
		position = { -6 6 }
		down = "[LocationView.Vars.Exists('tv_location_wonders_open')]"
		blockoverride "header_button_full_content" {}
		action_tooltip = {
			click_type = left
			click_mode = single
			title = "[SelectLocalization(LocationView.Vars.Exists('tv_location_wonders_open'), 'TV_LOCATION_WONDER_CLOSE_DETAILS', 'TV_LOCATION_WONDER_OPEN_DETAILS')]"
			on_action = "[LocationView.CloseBuildingQueueMenu]"
			on_action = "[LocationView.Vars.Toggle('tv_location_wonders_open')]"
		}
		tooltipwidget = { BasicFunctionalTooltip = {} }
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 6 0 }
			spacing = 3
			text_single = { layoutpolicy_horizontal = expanding autoresize = no align = center|nobaseline fontsize = 13 text = "[SelectLocalization(LocationView.Vars.Exists('tv_location_wonders_open'), 'TV_LOCATION_WONDER_CLOSE_DETAILS', 'TV_LOCATION_WONDER_OPEN_DETAILS')]" }
			icon = { visible = "[Not(LocationView.Vars.Exists('tv_location_wonders_open'))]" size = { 18 18 } texture = "gfx/interface/icons/location_icons/tv_wonder_arrow_right.dds" }
			icon = { visible = "[LocationView.Vars.Exists('tv_location_wonders_open')]" size = { 18 18 } texture = "gfx/interface/icons/location_icons/tv_wonder_arrow_left.dds" }
		}
	}
	type tv_location_wonders_panel = tv_location_wonders_menu {
		name = "tv_location_wonders_panel"
		parentanchor = top|right
		widgetanchor = top|left
		position = { 0 163 }
		allow_outside = yes
		visible = "[And(LocationView.Vars.Exists('tv_location_wonders_open'), LocationView.GetLocation.MakeScope.GetVariable('tv_wonder_tooltip_slot_1_id').IsSet)]"
	}
}
